# ==============================================================================
# SocietyOne Root .gitignore - Production Environment Protection
# ==============================================================================

# Local Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
*.env.local

# Dependency directories
node_modules/
**/node_modules/

# Production build artifacts
dist/
**/dist/
target/
**/target/
build/
**/build/
.tanstack/
**/.tanstack/

# IDE & Editor files
.idea/
**/.idea/
.vscode/
**/.vscode/
.trae/
**/.trae/
*.iml
*.iws
*.ipr
*.swp
*.swo
.DS_Store
Thumbs.db
*.tsbuildinfo
.vite/
**/.vite/

# Runtime & Scratch directories
scratch/
uploads/
societyone-backend/uploads/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# STS / Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
