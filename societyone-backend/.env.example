# ----------------------------------------------------
# SocietyOne Email Configuration (SMTP)
# ----------------------------------------------------
# To deliver real OTP emails to inboxes (e.g. Gmail):
# 1. Enable 2-Step Verification in your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character App Password:
#    https://myaccount.google.com/apppasswords
#    - Select app name: "SocietyOne"
#    - Click "Create" and copy the 16-character code (e.g. abcd efgh ijkl mnop)
# 3. Paste your Gmail address and 16-character App Password below:

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_gmail_address@gmail.com
SPRING_MAIL_PASSWORD=your_16_character_app_password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Sender details displayed to recipients
MAIL_FROM=your_gmail_address@gmail.com
MAIL_FROM_NAME=SocietyOne
MAIL_ENABLED=true
