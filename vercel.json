{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd societyone-frontend && npm run build",
  "outputDirectory": "societyone-frontend/dist",
  "installCommand": "cd societyone-frontend && npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://society-one-backend.onrender.com/api/:path*"
    },
    {
      "source": "/actuator/:path*",
      "destination": "https://society-one-backend.onrender.com/actuator/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://society-one-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/societyone-frontend/dist/index.html"
    }
  ]
}
